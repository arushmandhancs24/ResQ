# API Base URL for HTTP requests
# Default format: http://<host>:<port>
EXPO_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time dispatch updates
# Default format: ws://<host>:<port>/ws/dispatch
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws/dispatch

# Enable or disable mock mode (bypasses real backend)
# Set to 'true' to run fully offline/simulated
EXPO_PUBLIC_MOCK_MODE=true
